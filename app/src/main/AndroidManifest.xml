<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- API 33+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phone call detection -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Bluetooth headset detection (API ≤ 30) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Required for startBluetoothSco() and audio routing -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- am3-3 (FR3): auto-restart recording after a device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- am3-4 (FR4): let the user grant battery-optimization exemption from Settings -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- gps-location-capture-per-chunk / am-hotfix-active-location-fix: best-effort location
         capture per finished chunk. ACCESS_BACKGROUND_LOCATION was deliberately NOT requested by
         the original story (passive lastKnownLocation only); the hotfix supersedes that — the
         passive system cache goes stale after the first capture with nothing else refreshing it,
         so AudioRecordingService now registers active low-frequency LocationManager updates while
         recording, which on Android 10+ count as background requests for a foregroundServiceType
         "microphone" service and need this permission. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application
        android:name=".AudioMemoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".features.transcript.service.AudioRecordingService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!--
             am3-3 (FR3): android:exported="true" is required by the system for a receiver
             registering an implicit system broadcast (BOOT_COMPLETED) on Android 12+, even
             though no other app needs to invoke it directly.
        -->
        <receiver
            android:name=".features.transcript.receiver.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
